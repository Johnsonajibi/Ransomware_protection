[Version]
Signature   = "$Windows NT$"
Class       = "ActivityMonitor"
ClassGuid   = {b86dff51-a31e-4bac-b3cf-e8cfe75c9fc2}
Provider    = "AntiRansomware"
DriverVer = 03/29/2026,7.30.59.5
CatalogFile = AntiRansomwareKernel.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir          = 12
AntiRansomware.DriverFiles     = 12

[DefaultInstall.amd64]
OptionDesc          = "AntiRansomware Driver"
CopyFiles           = AntiRansomware.DriverFiles

[DefaultInstall.amd64.Services]
AddService          = %ServiceName%,,AntiRansomware.Service

[DefaultUninstall.amd64]
DelFiles            = AntiRansomware.DriverFiles

[DefaultUninstall.amd64.Services]
DelService          = %ServiceName%,0x200

[AntiRansomware.Service]
DisplayName      = %ServiceName%
Description      = "Anti-Ransomware MiniFilter Driver"
ServiceType      = 1
StartType        = 3
ErrorControl     = 1
ServiceBinary    = %12%\AntiRansomwareKernel.sys
LoadOrderGroup   = "FSFilter Activity Monitor"
AddReg           = AntiRansomware.AddRegistry
Dependencies     = "FltMgr"

[AntiRansomware.AddRegistry]
HKR,"Parameters","DefaultInstance",0x00000000,"AntiRansomware Instance"
HKR,"Parameters\Instances\AntiRansomware Instance","Altitude",0x00000000,"365000"
HKR,"Parameters\Instances\AntiRansomware Instance","Flags",0x00010001,0x0

[AntiRansomware.DriverFiles]
AntiRansomwareKernel.sys

[Strings]
ServiceName     = "AntiRansomwareKernel"
ManufacturerName = "AntiRansomware"
DiskId1         = "AntiRansomware Installation Disk"
